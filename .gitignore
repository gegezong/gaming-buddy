# ---- 依赖与构建产物 ----
node_modules/
dist/
__pycache__/
*.pyc

# ---- Python 虚拟环境 ----
.venv/
venv/
env/

# ---- 环境变量(含数据库密码 / 大模型密钥, 严禁提交) ----
.env
fastapi/.env
*.local
!**/.env.example

# ---- 运行时上传文件(启动时自动创建目录) ----
fastapi/file/

# ---- IDE 配置 ----
.idea/
.vscode/
*.iml

# ---- WorkBuddy 本地工作日志(含本机配置信息, 不入库) ----
.workbuddy/

# ---- 文档生成流水线中间产物 ----
output/

# ---- 微信开发者工具私有配置 ----
wx/project.private.config.json

# ---- 测试截图 ----
.qoder/*.png

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- 日志 ----
*.log
npm-debug.log*
