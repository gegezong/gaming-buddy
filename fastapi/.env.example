# ============================================================
# 后端配置文件模板(唯一配置入口): 复制为 .env 后填入自己的值
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# 启动命令: cd fastapi && uvicorn main:app --host 0.0.0.0 --port 8080 --reload
# ============================================================

# ---------- mysql数据库 ----------
# 数据库地址
DB_HOST=127.0.0.1
# 数据库端口
DB_PORT=3306
# 数据库用户名
DB_USER=your_db_user
# 数据库密码(重点!一定要改成你自己的)
DB_PASSWORD=your_db_password
# 数据库名(重点!一定要跟我们创建的数据库名称保持一致)
DB_NAME=gaming-buddy

# ---------- JWT 令牌 ----------
# 请求头字段名
TOKEN_HEADER=Authorization
# 令牌密钥(自行生成: python -c "import secrets; print(secrets.token_hex(32))")
TOKEN_SECRET=your_random_secret_key
# 令牌有效期(分钟)
TOKEN_EXPIRE_MINUTES=3000

# ---------- API 文档 ----------
# 是否开启接口文档页(开发调试建议开启, 生产部署可改为 false)
DOCS_ENABLED=true

# ---------- 上传文件保存基础路径 ----------
PROFILE=./file

# ---------- 大模型 API ----------
# API密钥
DEEPSEEK_API_KEY=your_api_key
# API地址(可指向中转网关)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称(deepseek-flash / deepseek-chat 等)
DEEPSEEK_MODEL=deepseek-flash
